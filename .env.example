# Copie este arquivo para .env.local e preencha.
# Nunca envie o .env.local para o GitHub.

# Supabase (quando for usar o banco na nuvem)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# URL do app (para retorno do Mercado Pago)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mercado Pago — use chaves de TESTE (sandbox), nunca de produção nesta fase
# Painel: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-sua_access_token_aqui
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-sua_public_key_aqui

# LucPaguei — quando tiver a conta/API, preencha (até lá o app usa modo teste)
LUC_PAGUEI_API_KEY=
LUC_PAGUEI_API_URL=
